+# =============================================================================
+# PROFILING UTILITIES
+# =============================================================================
+class ProcessorTimer:
+    """Simple timer utility for profiling processor performance."""
+
+    def __init__(self):
+        self.timings = defaultdict(lambda: {'total': 0.0, 'count': 0, 'min': float('inf'), 'max': 0.0})
+        self._start_times = {}
+
+    def start(self, label):
+        """Start timing a section."""
+        self._start_times[label] = time.perf_counter()
+
+    def stop(self, label):
+        """Stop timing a section and accumulate."""
+        if label in self._start_times:
+            elapsed = time.perf_counter() - self._start_times[label]
+            self.timings[label]['total'] += elapsed
+            self.timings[label]['count'] += 1
+            self.timings[label]['min'] = min(self.timings[label]['min'], elapsed)
+            self.timings[label]['max'] = max(self.timings[label]['max'], elapsed)
+            del self._start_times[label]
+            return elapsed
+        return 0.0
+
+    def report(self):
+        """Print timing report."""
+        coffea_console.print("\n" + "="*80)
+        coffea_console.print("PROFILING REPORT")
+        coffea_console.print("="*80)
+
+        # Sort by total time descending
+        sorted_timings = sorted(self.timings.items(), key=lambda x: x[1]['total'], reverse=True)
+
+        coffea_console.print(f"{'Section':<45} {'Total (s)':<12} {'Count':<8} {'Avg (ms)':<12} {'Min (ms)':<12} {'Max (ms)':<12}")
+        coffea_console.print("-"*80)
+
+        for label, data in sorted_timings:
+            avg_ms = (data['total'] / data['count'] * 1000) if data['count'] > 0 else 0
+            min_ms = data['min'] * 1000 if data['min'] != float('inf') else 0
+            max_ms = data['max'] * 1000
+            coffea_console.print(f"{label:<45} {data['total']:<12.4f} {data['count']:<8} {avg_ms:<12.3f} {min_ms:<12.3f} {max_ms:<12.3f}")
+
+        coffea_console.print("="*80 + "\n")
+
+# Global timer instance
+_TIMER = ProcessorTimer()
